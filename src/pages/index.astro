---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form
        class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5"
        data-testid="game-filters"
      >
        <fieldset>
          <legend class="mb-3 text-sm font-semibold text-slate-100">Categories</legend>
          <div class="flex flex-wrap gap-3" data-testid="category-filters">
            {categories.map((category) => (
              <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/50 px-3 py-2 text-sm text-slate-200 hover:border-blue-500/50 focus-within:ring-2 focus-within:ring-blue-500">
                <input
                  type="checkbox"
                  name="category"
                  value={category.id}
                  class="size-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
                  data-testid={`category-filter-${category.id}`}
                />
                {category.name}
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-end">
          <label class="flex flex-col gap-2 text-sm font-semibold text-slate-100" for="publisher-filter">
            Publisher
            <select
              id="publisher-filter"
              name="publisher"
              class="min-h-11 min-w-64 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
              ))}
            </select>
          </label>

          <button
            type="button"
            class="min-h-11 rounded-lg border border-slate-600 px-4 py-2 text-sm font-semibold text-slate-100 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="reset-filters"
          >
            Reset filters
          </button>
        </div>

        <p class="mt-4 text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-results-count">
          {games.length} games found
        </p>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden mt-6" role="status" aria-live="polite" data-testid="no-filter-results">
            <EmptyState text="No games match these filters." />
          </div>
        </>
      )}
    </div>
  </div>

  <script>
    const categoryInputs = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="category"]'),
    );
    const publisherSelect = document.querySelector<HTMLSelectElement>('#publisher-filter');
    const resetButton = document.querySelector<HTMLButtonElement>('[data-testid="reset-filters"]');
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'),
    );
    const count = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');
    const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

    function updateFilters(): void {
      const categoryIds = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.value),
      );
      const publisherId = publisherSelect?.value ?? '';
      let visibleCount = 0;

      for (const card of cards) {
        const categoryMatches =
          categoryIds.size === 0 || categoryIds.has(card.dataset.categoryId ?? '');
        const publisherMatches =
          publisherId === '' || card.dataset.publisherId === publisherId;
        const matches = categoryMatches && publisherMatches;

        card.hidden = !matches;
        if (matches) {
          visibleCount += 1;
        }
      }

      if (count) {
        count.textContent = `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} found`;
      }
      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount !== 0);
      }
    }

    for (const input of categoryInputs) {
      input.addEventListener('change', updateFilters);
    }
    publisherSelect?.addEventListener('change', updateFilters);
    resetButton?.addEventListener('click', () => {
      for (const input of categoryInputs) {
        input.checked = false;
      }
      if (publisherSelect) {
        publisherSelect.value = '';
      }
      updateFilters();
    });
  </script>
</Layout>
